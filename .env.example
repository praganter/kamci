# Optional. Copy to .env to override the throw-away dev defaults baked into docker-compose.yml.
# Use real, unique values for anything that is not a local demo.

# Must be at least 32 characters. Shared by the gateway and auth-service.
JWT_SECRET_KEY=change-me-change-me-change-me-0123456789

MONGO_USER=dev
MONGO_PASSWORD=dev
RABBITMQ_USER=kamci
RABBITMQ_PASSWORD=kamci

# Shared by every service: X-Internal-Token required on /internal/ endpoints. Use a long random value outside local demos.
INTERNAL_API_TOKEN=dev-internal-token

ADMIN_SECRET_KEY=dev-admin-key

# In-app purchase verification (auth-service). All optional: leave empty and the service still starts,
# the purchase endpoints just answer with an explicit error.
APPLE_BUNDLE_ID=
APPLE_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=
# Path inside the container to a Google Play service-account JSON (not the Firebase key). Mount it yourself, see docker-compose.yml.
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Apple sandbox receipts/notifications are accepted only when true. Comma-separated store product ids per plan.
APPLE_ALLOW_SANDBOX=false
IAP_MONTHLY_PRODUCT_IDS=
IAP_YEARLY_PRODUCT_IDS=

JAVA_OPTS=-Xmx256m

# Observability profile
GF_SECURITY_ADMIN_PASSWORD=admin
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts
