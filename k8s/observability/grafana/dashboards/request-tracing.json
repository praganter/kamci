{
  "__inputs": [],
  "__requires": [],
  "annotations": {"list": []},
  "description": "5xx errors → select trace → Tempo span tree + related logs side by side. Zipkin-compatible trace correlation via Spring Boot traceId in log pattern [service,traceId,spanId].",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["kamci", "tracing", "tempo"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Prometheus"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "tempo_datasource",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource",
        "label": "Tempo"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "loki_datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource",
        "label": "Loki"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(http_server_requests_seconds_count{status=~\"5..\"}, job)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(http_server_requests_seconds_count{status=~\"5..\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Service"
      },
      {
        "current": {"selected": true, "text": "", "value": ""},
        "hide": 0,
        "name": "traceId",
        "options": [{"selected": true, "text": "", "value": ""}],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox",
        "label": "Trace ID"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Request Tracing",
  "uid": "kamci-request-tracing",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "title": "5xx Error Overview",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(increase(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[$__range]))",
          "legendFormat": "total 5xx",
          "refId": "A"
        }
      ],
      "title": "5xx Errors (window)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]},
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {"h": 3, "w": 4, "x": 4, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[$__rate_interval])) * 100",
          "legendFormat": "error %",
          "refId": "A"
        }
      ],
      "title": "Error Rate %",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*5xx"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 3, "w": 16, "x": 8, "y": 1},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by(job) (rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{job}} 5xx",
          "refId": "A"
        }
      ],
      "title": "5xx Rate over Time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "id": 10,
      "title": "Recent 5xx Errors — click a row to get trace search hint",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Errors"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 50}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "p95 (s)"},
            "properties": [
              {"id": "unit", "value": "s"},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 14, "x": 0, "y": 5},
      "id": 11,
      "links": [],
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "enablePagination": false, "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Errors"}]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by(job, method, uri, status) (increase(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum by(job, method, uri, le) (rate(http_server_requests_seconds_bucket{job=~\"$service\", status=~\"5..\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "title": "5xx Error Breakdown (Service / Method / Endpoint)",
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "le": true},
            "renameByName": {"Value #A": "Errors", "Value #B": "p95 (s)", "job": "Service", "method": "Method", "status": "Status", "uri": "Endpoint"}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 10, "x": 14, "y": 5},
      "id": 12,
      "options": {
        "query": {
          "limit": 20,
          "queryType": "nativeSearch",
          "search": "",
          "serviceMapQuery": "",
          "serviceName": "",
          "spanName": ""
        }
      },
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 20,
          "queryType": "nativeSearch",
          "refId": "A",
          "filters": [
            {"id": "service-name", "operator": "=", "scope": "resource", "tag": "service.name", "value": "$service", "valueType": "string"}
          ]
        }
      ],
      "title": "Trace Search (service: $service)",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
      "id": 20,
      "title": "Trace Detail — paste Trace ID in variable above",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 14, "w": 12, "x": 0, "y": 16},
      "id": 21,
      "options": {},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "query": "${traceId}",
          "queryType": "traceId",
          "refId": "A"
        }
      ],
      "title": "Trace Span Tree — ${traceId}",
      "type": "traces"
    },
    {
      "datasource": {"type": "loki", "uid": "${loki_datasource}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 14, "w": 12, "x": 12, "y": 16},
      "id": 22,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${loki_datasource}"},
          "expr": "{namespace=\"kamci\"} |~ \"${traceId:raw}\"",
          "legendFormat": "",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "title": "Logs matching traceId — ${traceId}",
      "type": "logs"
    }
  ]
}
