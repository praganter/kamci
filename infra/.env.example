# Copy to .env. Compose reads it automatically.
JWT_SECRET_KEY=change-me-at-least-32-characters-long
GF_SECURITY_ADMIN_PASSWORD=admin
JAVA_OPTS=-Xmx256m
# CONFIG_DIR=../dt-config          # folder served by config-server in native mode
# CONFIG_SERVER_PROFILE=native     # empty/unset flag + CONFIG_GIT_URI => Git backend
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts
