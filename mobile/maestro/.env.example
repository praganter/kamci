# Copy to maestro/.env (git-ignored) and fill in accounts that exist on YOUR
# local backend. maestro/scripts/setup_test_accounts.sh can create them.
# All values below are fake placeholders.
API_BASE_URL=http://localhost:8080

USER_A_EMAIL=user.a@example.com
USER_A_PASSWORD=change-me-A
USER_B_EMAIL=user.b@example.com
USER_B_PASSWORD=change-me-B
USER_C_EMAIL=user.c@example.com
USER_C_PASSWORD=change-me-C
